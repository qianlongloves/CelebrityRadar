# 云函数部署密钥模板
#
# 用法：复制为同目录的 .env，填入自己的值后执行部署命令
#
#   cp .env.example .env
#
# 这些变量由 cloudbaserc.json 以 {{env.XXX}} 引用，**只在 `tcb fn deploy` 时**被读取，
# 部署后即固化进函数配置，本地无需长期保留。.env 已被 .gitignore 忽略。
#
# 缺 key 的影响：小程序仍能编译运行，但生成报告 / 联网检索 / 定时任务会在调用上游时报错。

# 云开发环境 ID（**必填**；端上与部署共用这一处来源，2026-10-13 起）。
#   · 端上：config/index.js 在构建期从这里注入 src/config/public.ts#cloudbaseEnvId
#     （改后需 `npm run build:weapp` 重新编译，热更新不生效）；
#   · 云端：cloudbaserc.json 顶部 envId 读取它（tcb CLI 部署）。
# 留空 = 端上不初始化云开发：登录、全部读写与云函数调用都不可用
# （构建期会打印警告，运行期报「未配置 TCB_ENV_ID」）。
# 若你的 CloudBase CLI 版本不解析该变量，可把 cloudbaserc.json 的 envId 直接写成环境 ID 字面值
# —— 但本行仍须非空（端上构建要它）。
TCB_ENV_ID=

# ── 大模型：厂商 × 质量档 × 能力槽（2026-10-12 v3）─────────────────
# 用户在「我的」页选两样：厂商（可随时切换）+ 质量档。
#   厂商：cloudbase（云开发 AI，零 key 兜底）/ deepseek / zhipu / moonshot / qwen / ark（火山方舟）
#   质量档：basic 基础版（免费）/ standard 标准版（会员）/ premium 高级版（会员）
# 具体模型由云端按用途选槽：报告 / 辅助走 structured（输出型），AI 问答走 reasoning（推理型）。
# 某档缺某槽时在同厂商内自动向下降档（如 Kimi 高级档写报告会降到标准档 k2.6）。
# 全部矩阵只在 cloudfunctions/aiProxy/llm.config.js 一处裁决
# （hotBoardRefresh 下有逐字一致的副本，由 npm test 钉住）。
#
# 通道①（默认）云开发 AI：无需 key。需要：
#   ① 控制台开通 AI 能力并确认模型可用（默认 structured=hy3、reasoning=hy4-preview）；
#   ② aiProxy / hotBoardRefresh 的 wx-server-sdk ≥ 4.0.1，函数超时调到 60s。
#
# 通道②（可选）外部厂商 OpenAI 兼容直连：配了哪家的 key，「我的」页就出现哪家。
#   DeepSeek：https://api.deepseek.com/v1
#   智谱 GLM：https://open.bigmodel.cn/api/paas/v4
#   Kimi：   https://api.moonshot.cn/v1
#   通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1（阿里云百炼，中国内地站）
#   火山方舟：https://ark.cn-beijing.volces.com/api/v3（字节跳动火山引擎，华北站；key=ARK_API_KEY）
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
#
# 可选覆写（一般不用；建议直接在云函数控制台配，避免联调值固化进部署）：
#   LLM_VENDOR                                   默认厂商（端上没带 / 定时任务时），默认 cloudbase
#   LLM_TIER                                     默认质量档，默认 basic（兼容旧值 fast/reason）
#   LLM_MODEL_<VENDOR>_<QUALITY>_<CAPABILITY>    覆盖任一槽位模型名
#       VENDOR ∈ CLOUDBASE/DEEPSEEK/ZHIPU/MOONSHOT/QWEN/ARK，QUALITY ∈ BASIC/STANDARD/PREMIUM，
#       CAPABILITY ∈ STRUCTURED/REASONING
#       例：LLM_MODEL_DEEPSEEK_STANDARD_REASONING=deepseek-v4-pro
#   LLM_HTTP_ENDPOINT_<VENDOR>                   覆盖厂商端点（接兼容网关 / 代理时用）
#       例：LLM_HTTP_ENDPOINT_DEEPSEEK=https://my-gateway.example.com/v1
#           LLM_HTTP_ENDPOINT_QWEN=https://dashscope-intl.aliyuncs.com/compatible-mode/v1（国际站）
# 上述两项「默认厂商 / 默认质量档」也由 cloudbaserc.json 引用，留空即用代码内默认值：
LLM_VENDOR=
LLM_TIER=

# ── 另一项核心：不填则「联网检索 / 生成报告」不可用 ─────────────────
# 联网检索密钥（博查 https://api.bochaai.com/v1/web-search）
BOCHA_API_KEY=

# 第二检索源（**默认关闭 · 合规口径**）：博查「抓到空内容」时的兜底，只有 aiProxy 用它。
#   SERPER_API_KEY（走 Google 索引）/ TAVILY_API_KEY（面向 LLM 的已清洗正文），任填其一即可。
# ⚠ 两家服务器都在**境外**：启用即构成「个人信息出境」（检索词含人名），依《个人信息保护法》
#   第 38/39 条须**单独同意** + 告知境外接收方 + 做个人信息保护影响评估（PIA）并留档。
#   故本项**默认留空**：不填 = 数据全程在境内（只走博查），隐私口径与「隐私与免责声明」一致。
#   确需启用时，请先补齐跨境合规（隐私政策增列跨境条款 + 端上单独同意 + PIA 留档）后再填 key；
#   前置条件清单与留档位置见 doc/个人信息保护影响评估.md「启用境外备用检索源的前置条件」一节。
SERPER_API_KEY=
TAVILY_API_KEY=

# ── 用到对应功能才需要 ──────────────────────────────────────────
# 订阅消息模板 ID（**唯一来源**：端上与云端都从这里取，只填这一处）。
#   · 云函数：cloudbaserc.json 用 {{env.X}} 取用注入 notifyFollowUpdates / keywordAlert / riskWatch；
#   · 端上：config/index.js 在构建期读同一份 .env，经 defineConstants 注入 src/config/public.ts
#     （改完需 `npm run build:weapp` 重新编译，热更新不生效）。
# 三个定时任务必须用**不同**模板，否则会互相吃掉一次性订阅授权（43101）。
# 留空 = 推送功能未配置（授权按钮不渲染、定时任务只落站内数据并跳过推送），站内功能不受影响。
SUBSCRIBE_TEMPLATE_ID=
ALERT_TEMPLATE_ID=
RISK_TEMPLATE_ID=

# 微信支付（服务商模式子商户号）与支付回调所在云环境 ID
WX_PAY_SUB_MCH_ID=
PAY_CALLBACK_ENV_ID=

# 仅 dbInit（建集合 / 改索引的一次性运维函数）需要：
# 小程序 AppID / AppSecret，用于换取 access_token 调 HTTP API
WX_APPID=
WX_APPSECRET=
# 写操作口令，自定义随机串。未配置时 dbInit 的写操作**一律拒绝**（只读巡检不受限）
# 口令强度就是这枚闸门的全部：它防的是「云函数部署后能被任意人 invoke」。
# 别用 pay2026 / admin888 这类可猜串 —— 生成 32 字节随机串（64 位十六进制）：
#   PowerShell: (-join (1..32 | % { '{0:x2}' -f (Get-Random -Max 256) }))
#   Bash:       openssl rand -hex 32
# 轮换后必须重新部署 dbInit（`tcb fn deploy dbInit --force`），调用方也要一起换。
DB_ADMIN_TOKEN=

# ── 运营写口口令（会员售后 / 运维动作，用到才配）────────────────────────
# payCallback 的退款 / 手动对账写口与 adminOps 的运维写口共用一枚口令 PAY_ADMIN_TOKEN；
# ADMIN_OPS_TOKEN 是 adminOps 自己的通行口令。均为自定义随机串，须与调用方约定一致。
# 未配置时对应运营接口**一律拒绝调用**（退款 / 对账 / 代理发货等运营动作不可用；
# 支付主链路与全部免费功能不受影响，属 fail-closed 的默认态）。
# 同样是 32 字节随机串，且**与 DB_ADMIN_TOKEN 不共用**（一枚口令只开一道门）。
# 轮换后必须重新部署 payCallback / adminOps / adminConsole（三者逐字比对这一枚）。
PAY_ADMIN_TOKEN=
ADMIN_OPS_TOKEN=

# payCallback 的「调用方闸门」开关。**已写进 cloudbaserc.json 为 strict，无需在这里配**，
# 记在这里只为回滚时有据可查（改完需 `tcb fn deploy payCallback` 才会带上函数，
# `tcb fn code update` 不更新环境变量）：
#   strict = 端上 wx.cloud.callFunction 的调用一律拒绝（**默认档**，未配置也是它）；
#   log    = 观察档：只记日志不拦截。怀疑真回调可能带 openid 时临时切过去取证；
#   off    = 一键回滚，完全不判。
# 判据是 getWXContext().OPENID：平台侧支付回调 / 定时器 / 控制台「云端测试」都没有它。
PAY_CALLBACK_GUARD=

# 仅 aiProxy 的 `test` 探针（真实各打一次博查 + 大模型，每次调用都花钱）：
# 未配置时该动作**一律拒绝**——这是期望的默认状态，端上业务链路（search / chat）不受影响。
# ⚠ 已写进 cloudbaserc.json ⇒ 每次 `tcb fn deploy` 都会把这里的值带上函数；留空 = 探针关闭。
# 探针一次要花真金白银，口令同理不能弱（可猜即等于对全网开放），用 32 字节随机串；
# 轮换后重新部署 aiProxy（`tcb fn deploy aiProxy --force`）。
AI_PROXY_TEST_TOKEN=

# ── 额度闸门联调开关（联调时放开「生成/检索/缓存写入」判定，计数照旧自增）────────
# 缺省 / 空 / 非 'off' 一律 = on（生产口径，fail-closed）。联调时填 off。
# ⚠ 已写进 cloudbaserc.json ⇒ 每次 `tcb fn deploy` 都会带上——上线前务必删掉或留空。
AI_PROXY_QUOTA_GUARD=

# ── 上游报文原始日志（排障用，默认关闭）────────────────────────────────────
# aiProxy 的 rawLog 只认字面量 'on'，其余（空 / off / 其它）一律 = 关闭。
# 开启后「上游模型到底回了什么」打在**云开发控制台 → 云函数 → 日志**里。
# ⚠ 那**不是**微信开发者工具的 Console：端上 rawIoLog 是另一套开关（见 src/config/local.ts），
#   它只能看到「云函数返回了什么」，永远看不到上游原文。两者互不相干，也不互斥。
# ⚠ 已写进 cloudbaserc.json ⇒ 每次 `tcb fn deploy` 都会带上——它会持续吐上游报文，
#   排障完务必改回空值并重新部署。
AI_PROXY_RAW_LOG=

# ── 运维告警（每日自检 opsCheck，10:30）──────────────────────────────────
# 企业微信群机器人地址：群设置 → 群机器人 → 添加 → 复制 Webhook，
# 形如 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx
# 留空 = 自检照常跑、只是不发消息（报告仍可从函数返回值看到）。
# ⚠ 只在**有异常**时发（某一路昨天一条日志都没有 / 有扫描失败 / 失败率过半），
#   不会每天报「一切正常」——每天报平安的消息等于训练人忽略它。
OPS_WEBHOOK_URL=
