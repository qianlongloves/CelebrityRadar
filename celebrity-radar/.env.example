# 云函数部署密钥模板
#
# 用法：复制为同目录的 .env，填入自己的值后执行部署命令
#
#   cp .env.example .env
#
# 这些变量由 cloudbaserc.json 以 ${env.XXX} 引用，**只在 `tcb fn deploy` 时**被读取，
# 部署后即固化进函数配置，本地无需长期保留。.env 已被 .gitignore 忽略。
#
# 缺 key 的影响：小程序仍能编译运行，但生成报告 / 联网检索 / 定时任务会在调用上游时报错。

# 云开发环境 ID（cloudbaserc.json 顶部 envId 读取它）。
# 若你的 CloudBase CLI 版本不解析该变量，直接把 cloudbaserc.json 的 envId 写成环境 ID 字面值。
TCB_ENV_ID=

# ── 大模型供应商：key 由平台（你）提供，用户只选是哪一家 ──────────────
# 哪几家能选由端上 src/config/public.ts 的 llm.providers 决定；端点、key 变量名、会员档位
# 由 cloudfunctions/*/llm.config.js 的供应商表决定。这里只负责「给用户能选的那几家填 key」。
# 变量名必须与表里的 apiKeyEnv 一致。
#
# ⚠ 用户现在可以自己在「我的 → 模型供应商」里切家（deepseek / qwen / zhipu / moonshot 四选一），
#   因此**端上列出的每一家都要填 key** —— 只填一家、清单里却列了四家，等于给了三个必然报错的选项。
#   （不想提供某一家，就从端上 llm.providers 里删掉它，而不是不填 key。）
#
# 只改云端默认（不影响用户自选）：LLM_PROVIDER 现在仅在**端上没带供应商、或带了个表里没有的 id**
# 时生效 —— 定时任务 hotBoardRefresh 走的就是这条（它没有端上偏好），aiProxy 里它是兜底。
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容，https://api.deepseek.com/v1）
DEEPSEEK_API_KEY=
# 通义千问（DashScope 兼容模式，https://dashscope.aliyuncs.com/compatible-mode/v1）
QWEN_API_KEY=
# 智谱 GLM（https://open.bigmodel.cn/api/paas/v4）
ZHIPU_API_KEY=
# Moonshot Kimi（https://api.moonshot.cn/v1）
MOONSHOT_API_KEY=
# OpenAI 官方（https://api.openai.com/v1）：境内云函数无法直连，通常改用自建中转 + LLM_BASE_URL
OPENAI_API_KEY=
#
# 自建网关 / 中转站 / 临时试新模型（会**覆盖**供应商表，连 LLM_PROVIDER 都不用改）：
# 直接在云函数控制台的环境变量里加 LLM_BASE_URL + LLM_MODEL + LLM_API_KEY 即可，不必写在这里
# （写成 ${env.XXX} 时，若 CLI 不解析会退化成字面量，反而会覆盖掉表内正确取值）。
# ⚠ 但它与「用户自选」冲突：LLM_MODEL 是全局覆盖，会把所有用户锁到同一个模型上，
#   端上仍显示各自选的档位。只当排障 / 中转开关用，常态运行请留给用户自选。

# ── 另一项核心：不填则「联网检索 / 生成报告」不可用 ─────────────────
# 联网检索密钥（博查 https://api.bochaai.com/v1/web-search）
BOCHA_API_KEY=

# ── 用到对应功能才需要 ──────────────────────────────────────────
# 订阅消息模板 ID。三个定时任务必须用**不同**模板，否则会互相吃掉一次性订阅授权（43101）
SUBSCRIBE_TEMPLATE_ID=
ALERT_TEMPLATE_ID=
RISK_TEMPLATE_ID=

# 微信支付（服务商模式子商户号）与支付回调所在云环境 ID
WX_PAY_SUB_MCH_ID=
PAY_CALLBACK_ENV_ID=

# 仅 dbInit（建集合 / 改索引的一次性运维函数）需要：
# 小程序 AppID / AppSecret，用于换取 access_token 调 HTTP API
WX_APPID=
WX_APPSECRET=
# 写操作口令，自定义随机串。未配置时 dbInit 的写操作**一律拒绝**（只读巡检不受限）
DB_ADMIN_TOKEN=
