{
  "version": "2.0",
  "envId": "{{env.TCB_ENV_ID}}",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "aiProxy",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "BOCHA_API_KEY": "{{env.BOCHA_API_KEY}}",
        "SERPER_API_KEY": "{{env.SERPER_API_KEY}}",
        "TAVILY_API_KEY": "{{env.TAVILY_API_KEY}}",
        "DEEPSEEK_API_KEY": "{{env.DEEPSEEK_API_KEY}}",
        "ZHIPU_API_KEY": "{{env.ZHIPU_API_KEY}}",
        "MOONSHOT_API_KEY": "{{env.MOONSHOT_API_KEY}}",
        "DASHSCOPE_API_KEY": "{{env.DASHSCOPE_API_KEY}}",
        "LLM_VENDOR": "{{env.LLM_VENDOR}}",
        "LLM_TIER": "{{env.LLM_TIER}}",
        "AI_PROXY_QUOTA_GUARD": "{{env.AI_PROXY_QUOTA_GUARD}}",
        "AI_PROXY_TEST_TOKEN": "{{env.AI_PROXY_TEST_TOKEN}}",
        "AI_PROXY_RAW_LOG": "{{env.AI_PROXY_RAW_LOG}}"
      }
    },
    {
      "name": "contentCheck",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true
    },
    {
      "name": "notifyFollowUpdates",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "BOCHA_API_KEY": "{{env.BOCHA_API_KEY}}",
        "SUBSCRIBE_TEMPLATE_ID": "{{env.SUBSCRIBE_TEMPLATE_ID}}"
      },
      "triggers": [
        {
          "name": "dailyNotify",
          "type": "timer",
          "config": "0 0 9 * * * *"
        }
      ]
    },
    {
      "name": "keywordAlert",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "BOCHA_API_KEY": "{{env.BOCHA_API_KEY}}",
        "ALERT_TEMPLATE_ID": "{{env.ALERT_TEMPLATE_ID}}"
      },
      "triggers": [
        {
          "name": "dailyKeywordAlert",
          "type": "timer",
          "config": "0 20 9 * * * *"
        }
      ]
    },
    {
      "name": "riskWatch",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "BOCHA_API_KEY": "{{env.BOCHA_API_KEY}}",
        "RISK_TEMPLATE_ID": "{{env.RISK_TEMPLATE_ID}}"
      },
      "triggers": [
        {
          "name": "dailyRiskWatch",
          "type": "timer",
          "config": "0 40 9 * * * *"
        }
      ]
    },
    {
      "name": "hotBoardRefresh",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "BOCHA_API_KEY": "{{env.BOCHA_API_KEY}}",
        "DEEPSEEK_API_KEY": "{{env.DEEPSEEK_API_KEY}}",
        "ZHIPU_API_KEY": "{{env.ZHIPU_API_KEY}}",
        "MOONSHOT_API_KEY": "{{env.MOONSHOT_API_KEY}}",
        "DASHSCOPE_API_KEY": "{{env.DASHSCOPE_API_KEY}}",
        "LLM_VENDOR": "{{env.LLM_VENDOR}}",
        "LLM_TIER": "{{env.LLM_TIER}}"
      },
      "triggers": [
        {
          "name": "dailyHotBoard",
          "type": "timer",
          "config": "0 30 6 * * * *"
        }
      ]
    },
    {
      "name": "quotaGuard",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true
    },
    {
      "name": "payCreate",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "WX_PAY_SUB_MCH_ID": "{{env.WX_PAY_SUB_MCH_ID}}",
        "PAY_CALLBACK_ENV_ID": "{{env.PAY_CALLBACK_ENV_ID}}"
      }
    },
    {
      "name": "payCallback",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "PAY_ADMIN_TOKEN": "{{env.PAY_ADMIN_TOKEN}}"
      },
      "triggers": [
        {
          "name": "payReconcile",
          "type": "timer",
          "config": "0 15 * * * * *"
        }
      ]
    },
    {
      "name": "dbInit",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true,
      "envVariables": {
        "DB_ADMIN_TOKEN": "{{env.DB_ADMIN_TOKEN}}",
        "WX_APPID": "{{env.WX_APPID}}",
        "WX_APPSECRET": "{{env.WX_APPSECRET}}"
      }
    },
    {
      "name": "userInit",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true
    },
    {
      "name": "userBackfill",
      "timeout": 60,
      "runtime": "Nodejs16.13",
      "installDependency": true
    }
  ]
}
