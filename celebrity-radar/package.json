    "@tarojs/webpack5-runner": "^3.6.25",
    "@types/node": "^20.12.0",
    "@types/react": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "babel-preset-taro": "^3.6.25",
    "sass": "^1.69.0",
