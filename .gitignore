node_modules/
dist/
.DS_Store
*.local
.codebuddy/

# 本地配置：环境 ID、本地调试开关（模板见 src/config/local.example.ts）
celebrity-radar/src/config/local.ts

# 微信开发者工具的私有配置（含本机编译设置 / 个人项目名）
project.private.config.json

# 云函数部署用的密钥（cloudbaserc.json 以 ${env.XXX} 读取）
.env
.env.*
!.env.example

# 文档统一目录（2026-10-18 迁移）：原先根 /doc/ 与 celebrity-radar/doc/ 两个目录并存，
# 现已全部并入 celebrity-radar/doc/（README / CHANGELOG 引用的路径就在这里）。
# 该目录**部分**受版本管理：README 链接的 PIPIA、产品优化路线图、报告生成流程问题清单已在仓库里；
# 迁移进来的设计方案 / 联调手册 / 云开发配置手册等目前是 **untracked** ——
# 是否随仓库分发由提交时决定，**这里刻意不写 ignore 规则**：
# 一个"看起来已经保护了"的目录级规则，反而会让人以为 git add -A 是安全的。
# 下面这条只保留作防呆：根 /doc/ 已不存在，若哪天又被建出来，别让它被静默提交。
/doc/

# 本地 AI 助手工作目录（记忆 / 日志，含本机路径与办理记录，不随仓库分发）
.workbuddy/

# 软著申请材料（源代码鉴别材料 / 说明书 / 生成报告），私有办理材料，不随仓库分发
softcopyright/
